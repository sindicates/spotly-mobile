# Copy to .env and fill in. .env is gitignored.
#
# Only EXPO_PUBLIC_* vars reach the app bundle. Anything with that prefix is
# shipped to every device in plaintext, so it must be safe to publish.

# Supabase project settings -> Data API / API keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- NOT client vars. Do not add EXPO_PUBLIC_ to any of these. ---
#
# OPENAI_API_KEY          set with: supabase secrets set OPENAI_API_KEY=...
#                         used only inside supabase/functions (embed, search)
#
# ANTHROPIC_API_KEY       set with: supabase secrets set ANTHROPIC_API_KEY=...
#                         used only inside supabase/functions (search) for the
#                         SEARCH-5 rerank pass. Optional: without it search
#                         degrades to cosine ranking instead of failing.
#
# SUPABASE_SERVICE_ROLE_KEY   seed + backfill scripts only, run locally, never
#                             committed. Must belong to the same stack as the URL
#                             above — mismatched, PostgREST falls back to anon.
#                             bypasses RLS entirely.
